{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client heartbeat",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  },
  "required": [
    "sessionId",
    "generation"
  ],
  "$id": "urn:milyonus:computer-use:heartbeat:v1"
}
